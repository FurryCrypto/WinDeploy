<Page x:Class="WinDeploy.Windows7.Views.BootPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:WinDeploy.Windows7.Markup"
 xmlns:controls="clr-namespace:WinDeploy.Windows7.Controls" Background="{StaticResource PageBackgroundBrush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid Margin="42,28,42,30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="{loc:Loc BootPageTitle.Text}" Style="{StaticResource PageTitle}"/>
    <TextBlock Grid.Row="1" Text="{loc:Loc BootPageSubtitle.Text}" Style="{StaticResource PageSubtitle}"/>
    <Grid Grid.Row="2" Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="{loc:Loc FirmwareModeLabel.Text}" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="Firmware" Grid.Column="1"/>
      <TextBlock Grid.Row="1" Text="{loc:Loc PartitionSchemeLabel.Text}" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="Scheme" Grid.Row="1" Grid.Column="1"/>
      <TextBlock Grid.Row="2" Text="{loc:Loc BootPartitionLabel.Text}" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="BootPartition" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap"/>
      <TextBlock Grid.Row="3" Text="{loc:Loc BootConfigurationLabel.Text}" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="BootConfiguration" Grid.Row="3" Grid.Column="1"/>
      <TextBlock Grid.Row="4" Text="{loc:Loc CompatibilityLabel.Text}" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="Compatibility" Grid.Row="4" Grid.Column="1" FontWeight="SemiBold"/>
    </Grid>
    <controls:InfoBanner Grid.Row="3" x:Name="Banner" Margin="0,0,0,12"/>
    <StackPanel Grid.Row="4">
      <CheckBox x:Name="Bypass" Content="{loc:Loc UnsupportedWindows11Toggle.Content}" Margin="0,0,0,5" Visibility="Collapsed" Checked="Bypass_Changed" Unchecked="Bypass_Changed"/>
      <TextBlock x:Name="BypassDescription" Text="{loc:Loc UnsupportedWindows11Description.Text}" Foreground="#FF666666" TextWrapping="Wrap" Margin="22,0,0,10" Visibility="Collapsed"/>
      <ItemsControl x:Name="Issues"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#FFD0D0D0" BorderThickness="0,0,0,1" Padding="5,7"><StackPanel Orientation="Horizontal"><Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0"/><TextBlock Text="{Binding Text}" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <Expander x:Name="Advanced" Header="{loc:Loc AdvancedDetailsTitle.Text}" Margin="0,12,0,0" Visibility="Collapsed"><TextBlock x:Name="AdvancedText" TextWrapping="Wrap" FontFamily="Consolas" Margin="8"/></Expander>
    </StackPanel>
    <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="{loc:Loc BackButton.Content}" Width="88" Click="Back_Click" Margin="0,0,8,0"/><Button x:Name="Review" Content="{loc:Loc ReviewInstallationButton.Content}" Style="{StaticResource PrimaryButton}" Click="Review_Click"/></StackPanel>
  </Grid></ScrollViewer>
</Page>
