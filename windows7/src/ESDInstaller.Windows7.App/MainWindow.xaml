<Window x:Class="ESDInstaller.Windows7.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:loc="clr-namespace:ESDInstaller.Windows7.Markup"
 Title="{loc:Loc AppTitle}" Width="1000" Height="700" MinWidth="850" MinHeight="600"
 WindowStartupLocation="CenterScreen" Background="#FFF7F7F7">
  <Grid x:Name="RootGrid">
    <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="27"/></Grid.RowDefinitions>
    <Border x:Name="ToolbarBorder" BorderBrush="#FFB6B6B6" BorderThickness="0,0,0,1">
      <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#F9FFFFFF"/><GradientStop Color="#E5E5EBF0" Offset="1"/></LinearGradientBrush></Border.Background>
      <DockPanel Margin="5,4">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
          <Button x:Name="OpenImageButton" Style="{StaticResource ToolbarButton}" Click="OpenImage_Click">
            <StackPanel Orientation="Horizontal"><Image Source="{loc:StockIcon FolderOpen}" Width="22" Height="22" Margin="0,0,7,0"/><TextBlock Text="{loc:Loc ToolbarOpenImage.Text}" VerticalAlignment="Center"/></StackPanel>
          </Button>
          <Button x:Name="RefreshDisksButton" Style="{StaticResource ToolbarButton}" Click="RefreshDisks_Click">
            <StackPanel Orientation="Horizontal"><TextBlock Text="↻" Foreground="#FF1578B9" FontSize="24" Margin="0,-4,7,0"/><TextBlock Text="{loc:Loc ToolbarRefreshDisks.Text}" VerticalAlignment="Center"/></StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
          <Button x:Name="SettingsButton" Style="{StaticResource ToolbarButton}" Click="Settings_Click">
            <StackPanel Orientation="Horizontal"><Image Source="{loc:StockIcon Settings}" Width="22" Height="22" Margin="0,0,7,0"/><TextBlock Text="{loc:Loc ToolbarSettings.Text}" VerticalAlignment="Center"/></StackPanel>
          </Button>
          <Button Style="{StaticResource ToolbarButton}" Click="Help_Click">
            <StackPanel Orientation="Horizontal"><Image Source="{loc:StockIcon Help}" Width="22" Height="22" Margin="0,0,7,0"/><TextBlock Text="{loc:Loc ToolbarHelp.Text}" VerticalAlignment="Center"/></StackPanel>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="215"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="#FFF0F0F0" BorderBrush="#FFC7C7C7" BorderThickness="0,0,1,0">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="{loc:Loc StepsHeader.Text}" FontSize="11" FontWeight="Bold" Foreground="#FF555555" Margin="18,18,12,10"/>
          <StackPanel Grid.Row="1">
            <Border x:Name="Step0" BorderThickness="3,0,0,0" Padding="15,10"><TextBlock Text="{loc:Loc StepImage.Text}"/></Border>
            <Border x:Name="Step1" BorderThickness="3,0,0,0" Padding="15,10"><TextBlock Text="{loc:Loc StepEdition.Text}"/></Border>
            <Border x:Name="Step2" BorderThickness="3,0,0,0" Padding="15,10"><TextBlock Text="{loc:Loc StepDestination.Text}"/></Border>
            <Border x:Name="Step3" BorderThickness="3,0,0,0" Padding="15,10"><TextBlock Text="{loc:Loc StepBoot.Text}"/></Border>
            <Border x:Name="Step4" BorderThickness="3,0,0,0" Padding="15,10"><TextBlock Text="{loc:Loc StepReview.Text}"/></Border>
            <Border x:Name="Step5" BorderThickness="3,0,0,0" Padding="15,10"><TextBlock Text="{loc:Loc StepInstall.Text}"/></Border>
          </StackPanel>
          <Border Grid.Row="2" BorderBrush="#FF80B8E0" BorderThickness="1" Background="#FFEAF5FC" Margin="12" Padding="10">
            <StackPanel><TextBlock Text="{loc:Loc SafetyFirst.Text}" FontWeight="SemiBold"/><TextBlock Text="{loc:Loc SafetySidebarText.Text}" Margin="0,4,0,0" TextWrapping="Wrap" FontSize="11" Foreground="#FF4A4A4A"/></StackPanel>
          </Border>
        </Grid>
      </Border>
      <Frame x:Name="ContentFrame" Grid.Column="1" NavigationUIVisibility="Hidden" Background="#FFF7F7F7"/>
    </Grid>
    <Border Grid.Row="2" Background="#FFF2F2F2" BorderBrush="#FFCBCBCB" BorderThickness="0,1,0,0">
      <Grid Margin="7,0"><TextBlock x:Name="StatusText" VerticalAlignment="Center" Text="{loc:Loc StatusReady}"/>
        <TextBlock x:Name="ModeText" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#FF555555"/>
      </Grid>
    </Border>
  </Grid>
</Window>
