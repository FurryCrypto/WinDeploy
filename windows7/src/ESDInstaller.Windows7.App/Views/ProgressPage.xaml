<Page x:Class="ESDInstaller.Windows7.Views.ProgressPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:ESDInstaller.Windows7.Markup"
 xmlns:controls="clr-namespace:ESDInstaller.Windows7.Controls" Background="{StaticResource PageBackgroundBrush}">
  <Grid Margin="42,28,42,30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="{loc:Loc ProgressPageTitle.Text}" Style="{StaticResource PageTitle}"/>
    <TextBlock Grid.Row="1" Text="{loc:Loc ProgressPageSubtitle.Text}" Style="{StaticResource PageSubtitle}"/>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="Operation" Text="{loc:Loc ProgressWaiting.Text}" FontWeight="SemiBold"/><TextBlock x:Name="Percent" Grid.Column="1" HorizontalAlignment="Right" Text="0%" FontSize="16"/>
      <ProgressBar x:Name="Overall" Grid.Row="1" Grid.ColumnSpan="2" Height="20" Minimum="0" Maximum="100" Margin="0,9,0,0"/>
    </Grid>
    <DockPanel Grid.Row="3" Margin="0,12,0,10"><TextBlock x:Name="Elapsed" DockPanel.Dock="Right" HorizontalAlignment="Right"/><TextBlock x:Name="Detail" TextWrapping="Wrap" Foreground="#FF666666"/></DockPanel>
    <Expander Grid.Row="4" Header="{loc:Loc InstallationLogExpander.Header}" IsExpanded="True">
      <TextBox x:Name="Log" IsReadOnly="True" FontFamily="Consolas" FontSize="11" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
    </Expander>
    <StackPanel Grid.Row="5" Margin="0,14,0,0">
      <controls:InfoBanner x:Name="ResultBanner" Visibility="Collapsed" Margin="0,0,0,12"/>
      <Grid><StackPanel Orientation="Horizontal"><Button x:Name="OpenLog" Content="{loc:Loc OpenLogButton.Content}" IsEnabled="False" Click="OpenLog_Click" Margin="0,0,8,0"/><Button x:Name="SaveLog" Content="{loc:Loc SaveLogAsButton.Content}" IsEnabled="False" Click="SaveLog_Click"/></StackPanel>
        <StackPanel x:Name="RestartButtons" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed"><Button Content="{loc:Loc RestartLaterButton.Content}" Click="RestartLater_Click" Margin="0,0,8,0"/><Button Content="{loc:Loc RestartNowButton.Content}" Style="{StaticResource PrimaryButton}" Click="RestartNow_Click"/></StackPanel>
      </Grid>
    </StackPanel>
  </Grid>
</Page>
