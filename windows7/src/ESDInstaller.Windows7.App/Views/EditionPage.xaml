<Page x:Class="ESDInstaller.Windows7.Views.EditionPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:ESDInstaller.Windows7.Markup"
 xmlns:controls="clr-namespace:ESDInstaller.Windows7.Controls" Background="{StaticResource PageBackgroundBrush}">
  <Grid Margin="42,28,42,30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="{loc:Loc EditionPageTitle.Text}" Style="{StaticResource PageTitle}"/>
    <TextBlock Grid.Row="1" Text="{loc:Loc EditionPageSubtitle.Text}" Style="{StaticResource PageSubtitle}"/>
    <ListBox Grid.Row="2" x:Name="Editions" Background="White" BorderBrush="#FFBDBDBD" SelectionChanged="Editions_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate><DataTemplate><Grid Margin="10,7" Width="620"><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <controls:WindowsImageMark Width="42" Height="42"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Foreground="#FF666666" Margin="0,3,0,0"/></StackPanel>
        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock Text="{Binding Architecture}" HorizontalAlignment="Right"/><TextBlock Text="{Binding Technical}" Foreground="#FF666666" Margin="0,3,0,0"/></StackPanel>
      </Grid></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button Content="{loc:Loc BackButton.Content}" Width="88" Click="Back_Click" Margin="0,0,8,0"/>
      <Button x:Name="Next" Content="{loc:Loc NextButton.Content}" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="Next_Click"/>
    </StackPanel>
  </Grid>
</Page>
