<Window x:Class="ESDInstaller.Windows7.UpdateWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Width="470" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel x:Name="InformationPanel">
      <TextBlock x:Name="HeadingText" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
      <TextBlock x:Name="AvailableVersionText" FontSize="14" Margin="0,0,0,6"/>
      <TextBlock x:Name="CurrentVersionText" Foreground="#FF555555"/>
      <TextBlock x:Name="NotesText" Margin="0,16,0,0" TextWrapping="Wrap" MaxHeight="72"/>
      <TextBlock x:Name="ErrorText" Margin="0,12,0,0" Foreground="#FFC42B1C" TextWrapping="Wrap" Visibility="Collapsed"/>
    </StackPanel>
    <StackPanel x:Name="DownloadPanel" Visibility="Collapsed">
      <TextBlock x:Name="DownloadStatusText" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock x:Name="PercentageText" Margin="0,14,0,5"/>
      <ProgressBar x:Name="DownloadProgress" Height="18" Minimum="0" Maximum="100"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
      <Button x:Name="CloseButton" Width="90" Click="CloseButton_Click" Margin="0,0,8,0"/>
      <Button x:Name="UpdateButton" Width="90" Style="{StaticResource PrimaryButton}" Click="UpdateButton_Click"/>
      <Button x:Name="CancelDownloadButton" Width="90" Visibility="Collapsed" Click="CancelDownloadButton_Click"/>
    </StackPanel>
  </Grid>
</Window>
