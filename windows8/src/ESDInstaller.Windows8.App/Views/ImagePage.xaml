<Page x:Class="ESDInstaller.Windows8.Views.ImagePage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:loc="clr-namespace:ESDInstaller.Windows8.Markup"
 xmlns:controls="clr-namespace:ESDInstaller.Windows8.Controls"
 Background="{StaticResource PageBackgroundBrush}">
  <Grid Margin="32,26,32,22">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="760" HorizontalAlignment="Left">
        <TextBlock Text="{loc:Loc ImagePageTitle.Text}" Style="{StaticResource PageTitle}"/>
        <TextBlock Text="{loc:Loc ImagePageSubtitle.Text}" Style="{StaticResource PageSubtitle}"/>
        <Border x:Name="DropArea" Style="{StaticResource ExplorerCard}" Padding="24" MinHeight="170"
                AllowDrop="True" Drop="DropArea_Drop" DragOver="DropArea_DragOver">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <controls:SymbolIcon Kind="File" Width="44" Height="44" Foreground="{StaticResource ExplorerBlueBrush}" Margin="0,0,0,12"/>
            <Button Content="{loc:Loc SelectImageButton.Content}" Style="{StaticResource PrimaryButton}" Click="Select_Click"/>
            <TextBlock Text="{loc:Loc ImageDropHint.Text}" FontSize="12" Foreground="#FF666666" HorizontalAlignment="Center" Margin="0,12,0,0"/>
            <ProgressBar x:Name="ExtractionProgress" Width="260" Height="12" Margin="0,12,0,0" Visibility="Collapsed" IsIndeterminate="True"/>
          </StackPanel>
        </Border>
        <controls:InfoBanner x:Name="Banner" Visibility="Collapsed" Margin="0,16,0,0"/>
        <Border x:Name="Details" Style="{StaticResource ExplorerCard}" Visibility="Collapsed" Margin="0,16,0,0">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="155"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="{loc:Loc ImageFilenameLabel.Text}" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="Filename" Grid.Column="1" TextWrapping="Wrap"/>
            <TextBlock Grid.Row="1" Text="{loc:Loc ImageWindowsVersionLabel.Text}" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="Version" Grid.Row="1" Grid.Column="1"/>
            <TextBlock Grid.Row="2" Text="{loc:Loc ImageArchitectureLabel.Text}" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="Architecture" Grid.Row="2" Grid.Column="1"/>
            <TextBlock Grid.Row="3" Text="{loc:Loc ImageTypeLabel.Text}" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="Type" Grid.Row="3" Grid.Column="1"/>
            <TextBlock Grid.Row="4" Text="{loc:Loc ImageFileSizeLabel.Text}" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="Size" Grid.Row="4" Grid.Column="1"/>
            <TextBlock Grid.Row="5" Text="{loc:Loc ImageEditionCountLabel.Text}" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="EditionCount" Grid.Row="5" Grid.Column="1"/>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="Next" Content="{loc:Loc NextButton.Content}" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="Next_Click"/>
    </StackPanel>
  </Grid>
</Page>
