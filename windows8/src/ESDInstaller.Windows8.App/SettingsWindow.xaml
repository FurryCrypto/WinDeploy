<Window x:Class="ESDInstaller.Windows8.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:ESDInstaller.Windows8.Markup"
 Title="{loc:Loc SettingsTitle}" Width="470" Height="385" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="{loc:Loc LanguageLabel}" Margin="0,0,0,5"/><ComboBox x:Name="LanguagePicker"/>
      <CheckBox x:Name="Advanced" Content="{loc:Loc AdvancedMode}" Margin="0,18,0,5"/>
      <TextBlock Text="{loc:Loc AdvancedModeDescription}" TextWrapping="Wrap" Foreground="#FF555555"/>
      <CheckBox x:Name="AutomaticUpdates" Content="{loc:Loc CheckForUpdatesAutomatically}" Margin="0,18,0,8"/>
      <Button x:Name="CheckUpdates" Content="{loc:Loc CheckForUpdates}" Width="150" HorizontalAlignment="Left" Click="CheckUpdates_Click"/>
      <TextBlock x:Name="UpdateStatus" Margin="0,7,0,0" TextWrapping="Wrap" Foreground="#FF555555"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="{loc:Loc Save}" Width="88" IsDefault="True" Click="Save_Click" Margin="0,0,8,0"/>
      <Button Content="{loc:Loc Cancel}" Width="88" IsCancel="True"/>
    </StackPanel>
  </Grid>
</Window>
