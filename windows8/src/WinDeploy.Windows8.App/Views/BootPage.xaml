<Page x:Class="WinDeploy.Windows8.Views.BootPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:loc="clr-namespace:WinDeploy.Windows8.Markup"
 xmlns:controls="clr-namespace:WinDeploy.Windows8.Controls"
 Background="{StaticResource PageBackgroundBrush}">
  <Grid Margin="32,26,32,22">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel MaxWidth="760" HorizontalAlignment="Left">
        <TextBlock Text="{loc:Loc BootPageTitle.Text}" Style="{StaticResource PageTitle}"/>
        <TextBlock Text="{loc:Loc BootPageSubtitle.Text}" Style="{StaticResource PageSubtitle}"/>
        <Border Style="{StaticResource ExplorerCard}">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="{loc:Loc FirmwareModeLabel.Text}" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="Firmware" Grid.Column="1"/>
            <TextBlock Grid.Row="1" Text="{loc:Loc PartitionSchemeLabel.Text}" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="Scheme" Grid.Row="1" Grid.Column="1"/>
            <TextBlock Grid.Row="2" Text="{loc:Loc BootPartitionLabel.Text}" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="BootPartition" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap"/>
            <TextBlock Grid.Row="3" Text="{loc:Loc BootConfigurationLabel.Text}" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="BootConfiguration" Grid.Row="3" Grid.Column="1"/>
            <TextBlock Grid.Row="4" Text="{loc:Loc CompatibilityLabel.Text}" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="Compatibility" Grid.Row="4" Grid.Column="1" FontWeight="SemiBold"/>
          </Grid>
        </Border>
        <controls:InfoBanner x:Name="Banner" Margin="0,15,0,0"/>
        <ItemsControl x:Name="Issues" Margin="0,8,0,0">
          <ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#FFD0D0D0" BorderThickness="0,0,0,1" Padding="5,7"><StackPanel Orientation="Horizontal"><controls:SymbolIcon Kind="{Binding Kind}" Foreground="{Binding Foreground}" Width="16" Height="16" Margin="0,0,8,0"/><TextBlock Text="{Binding Text}" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border x:Name="Advanced" Style="{StaticResource ExplorerCard}" Visibility="Collapsed" Margin="0,15,0,0">
          <StackPanel>
            <TextBlock Text="{loc:Loc AdvancedDetailsTitle.Text}" Style="{StaticResource SectionTitle}"/>
            <TextBlock x:Name="AdvancedText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Margin="0,6,0,0"/>
            <Rectangle Height="1" Fill="#FFD0D0D0" Margin="0,14,0,8"/>
            <CheckBox x:Name="Bypass" Content="{loc:Loc UnsupportedWindows11Toggle.Content}" Visibility="Collapsed" Checked="Bypass_Changed" Unchecked="Bypass_Changed"/>
            <TextBlock x:Name="BypassDescription" Text="{loc:Loc UnsupportedWindows11Description.Text}" Foreground="#FF8A4B00" TextWrapping="Wrap" Margin="22,0,0,0" Visibility="Collapsed"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Grid Grid.Row="1" Margin="0,16,0,0"><Button Content="{loc:Loc BackButton.Content}" Click="Back_Click"/><Button x:Name="Review" Content="{loc:Loc ReviewInstallationButton.Content}" HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}" Click="Review_Click"/></Grid>
  </Grid>
</Page>
