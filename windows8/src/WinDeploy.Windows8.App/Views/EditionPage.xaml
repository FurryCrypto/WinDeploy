<Page x:Class="WinDeploy.Windows8.Views.EditionPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:loc="clr-namespace:WinDeploy.Windows8.Markup"
 xmlns:controls="clr-namespace:WinDeploy.Windows8.Controls"
 Background="{StaticResource PageBackgroundBrush}">
  <Grid Margin="32,26,32,22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16">
      <TextBlock Text="{loc:Loc EditionPageTitle.Text}" Style="{StaticResource PageTitle}"/>
      <TextBlock Text="{loc:Loc EditionPageSubtitle.Text}" Foreground="#FF555555" TextWrapping="Wrap" Margin="0,7,0,0"/>
    </StackPanel>
    <Border Grid.Row="1" Style="{StaticResource ExplorerCard}" Padding="0">
      <ListBox x:Name="Editions" Background="White" BorderThickness="0" SelectionChanged="Editions_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid Margin="14,10" MinHeight="42">
              <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="125"/></Grid.ColumnDefinitions>
              <controls:WindowsImageMark Width="32" Height="32" Generation="{Binding Generation}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
              <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Foreground="#FF666666" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
              <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock Text="{Binding Architecture}" HorizontalAlignment="Right"/><TextBlock Text="{Binding Technical}" FontSize="12" Foreground="#FF666666" Margin="0,3,0,0" HorizontalAlignment="Right"/></StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
    <Grid Grid.Row="2" Margin="0,16,0,0"><Button Content="{loc:Loc BackButton.Content}" Click="Back_Click"/><Button x:Name="Next" Content="{loc:Loc NextButton.Content}" HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="Next_Click"/></Grid>
  </Grid>
</Page>
