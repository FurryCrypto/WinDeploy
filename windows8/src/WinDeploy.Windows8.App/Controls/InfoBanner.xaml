<UserControl x:Class="WinDeploy.Windows8.Controls.InfoBanner"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:WinDeploy.Windows8.Controls">
  <Border x:Name="BannerBorder" BorderThickness="1" Padding="12" Background="#FFF3F8FC" BorderBrush="#FF86B9DD">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <controls:SymbolIcon x:Name="Icon" Kind="Information" Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,0,0"/>
      <StackPanel Grid.Column="1">
        <TextBlock x:Name="TitleText" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="MessageText" Margin="0,3,0,0" TextWrapping="Wrap" Foreground="#FF444444"/>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
