<Window x:Class="WinDeploy.Windows8.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:loc="clr-namespace:WinDeploy.Windows8.Markup"
 xmlns:controls="clr-namespace:WinDeploy.Windows8.Controls"
 Title="{loc:Loc AppTitle}" Width="1000" Height="700" MinWidth="850" MinHeight="600"
 WindowStartupLocation="CenterScreen" Background="#FFF7F7F7">
  <Grid x:Name="RootGrid" Background="#FFF7F7F7">
    <Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
    <Border x:Name="ToolbarBorder" Background="White" BorderBrush="{StaticResource ExplorerBorderBrush}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <Button x:Name="OpenImageButton" Style="{StaticResource ToolbarButton}" Click="OpenImage_Click">
            <StackPanel Orientation="Horizontal"><controls:SymbolIcon Kind="FolderOpen" Width="18" Height="18" Foreground="{StaticResource ExplorerBlueBrush}" Margin="0,0,7,0"/><TextBlock Text="{loc:Loc ToolbarOpenImage.Text}" VerticalAlignment="Center"/></StackPanel>
          </Button>
          <Button x:Name="RefreshDisksButton" Style="{StaticResource ToolbarButton}" Click="RefreshDisks_Click">
            <StackPanel Orientation="Horizontal"><controls:SymbolIcon Kind="Refresh" Width="18" Height="18" Foreground="{StaticResource ExplorerBlueBrush}" Margin="0,0,7,0"/><TextBlock Text="{loc:Loc ToolbarRefreshDisks.Text}" VerticalAlignment="Center"/></StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button x:Name="SettingsButton" Style="{StaticResource ToolbarButton}" Click="Settings_Click">
            <StackPanel Orientation="Horizontal"><controls:SymbolIcon Kind="Settings" Width="18" Height="18" Margin="0,0,7,0"/><TextBlock Text="{loc:Loc ToolbarSettings.Text}" VerticalAlignment="Center"/></StackPanel>
          </Button>
          <Button Style="{StaticResource ToolbarButton}" Click="Help_Click">
            <StackPanel Orientation="Horizontal"><controls:SymbolIcon Kind="Help" Width="18" Height="18" Margin="0,0,7,0"/><TextBlock Text="{loc:Loc ToolbarHelp.Text}" VerticalAlignment="Center"/></StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="215"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="{StaticResource ExplorerPaneBrush}" BorderBrush="{StaticResource ExplorerBorderBrush}" BorderThickness="0,0,1,0">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="{loc:Loc StepsHeader.Text}" FontSize="12" FontWeight="SemiBold" Foreground="#FF555555" Margin="18,18,0,8"/>
          <StackPanel Grid.Row="1">
            <Border x:Name="Step0" BorderThickness="3,0,0,0" Padding="15,10,8,10"><StackPanel Orientation="Horizontal"><controls:SymbolIcon Kind="File" Width="18" Height="18" Margin="0,0,10,0"/><TextBlock Text="{loc:Loc StepImage.Text}" VerticalAlignment="Center"/></StackPanel></Border>
            <Border x:Name="Step1" BorderThickness="3,0,0,0" Padding="15,10,8,10"><StackPanel Orientation="Horizontal"><controls:SymbolIcon Kind="Editions" Width="18" Height="18" Margin="0,0,10,0"/><TextBlock Text="{loc:Loc StepEdition.Text}" VerticalAlignment="Center"/></StackPanel></Border>
            <Border x:Name="Step2" BorderThickness="3,0,0,0" Padding="15,10,8,10"><StackPanel Orientation="Horizontal"><controls:SymbolIcon Kind="Disk" Width="18" Height="18" Margin="0,0,10,0"/><TextBlock Text="{loc:Loc StepDestination.Text}" VerticalAlignment="Center"/></StackPanel></Border>
            <Border x:Name="Step3" BorderThickness="3,0,0,0" Padding="15,10,8,10"><StackPanel Orientation="Horizontal"><controls:SymbolIcon Kind="Boot" Width="18" Height="18" Margin="0,0,10,0"/><TextBlock Text="{loc:Loc StepBoot.Text}" VerticalAlignment="Center"/></StackPanel></Border>
            <Border x:Name="Step4" BorderThickness="3,0,0,0" Padding="15,10,8,10"><StackPanel Orientation="Horizontal"><controls:SymbolIcon Kind="Review" Width="18" Height="18" Margin="0,0,10,0"/><TextBlock Text="{loc:Loc StepReview.Text}" VerticalAlignment="Center"/></StackPanel></Border>
            <Border x:Name="Step5" BorderThickness="3,0,0,0" Padding="15,10,8,10"><StackPanel Orientation="Horizontal"><controls:SymbolIcon Kind="Install" Width="18" Height="18" Margin="0,0,10,0"/><TextBlock Text="{loc:Loc StepInstall.Text}" VerticalAlignment="Center"/></StackPanel></Border>
          </StackPanel>
          <Border Grid.Row="2" Margin="15,24,15,12" Padding="10" Background="#FFE9F3FB" BorderBrush="#FFB6D6F2" BorderThickness="1">
            <StackPanel>
              <StackPanel Orientation="Horizontal"><controls:SymbolIcon Kind="Information" Width="16" Height="16" Foreground="{StaticResource ExplorerBlueBrush}" Margin="0,0,7,0"/><TextBlock Text="{loc:Loc SafetyFirst.Text}" FontWeight="SemiBold"/></StackPanel>
              <TextBlock Text="{loc:Loc SafetySidebarText.Text}" Margin="0,5,0,0" TextWrapping="Wrap" FontSize="12" Foreground="#FF444444"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>
      <Frame x:Name="ContentFrame" Grid.Column="1" NavigationUIVisibility="Hidden" Background="#FFF7F7F7"/>
    </Grid>
    <Border Grid.Row="2" Background="#FFF2F2F2" BorderBrush="{StaticResource ExplorerBorderBrush}" BorderThickness="0,1,0,0">
      <Grid Margin="10,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><controls:SymbolIcon Kind="Information" Width="13" Height="13" Margin="0,0,7,0"/><TextBlock x:Name="StatusText" VerticalAlignment="Center" Text="{loc:Loc StatusReady}" FontSize="12"/></StackPanel>
        <TextBlock x:Name="ModeText" Grid.Column="1" VerticalAlignment="Center" FontSize="12" Foreground="#FF555555"/>
      </Grid>
    </Border>
  </Grid>
</Window>
