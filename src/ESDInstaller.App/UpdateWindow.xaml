<Window
    x:Class="ESDInstaller.UpdateWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootGrid" Background="White" Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="InformationPanel" Spacing="10">
            <TextBlock x:Name="HeadingText" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="AvailableVersionText" FontSize="15" />
            <TextBlock x:Name="CurrentVersionText" Foreground="#FF555555" />
            <TextBlock x:Name="NotesText" Margin="0,8,0,0" TextWrapping="Wrap" MaxHeight="72" />
            <TextBlock x:Name="ErrorText" Foreground="#FFC42B1C" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>

        <StackPanel x:Name="DownloadPanel" Spacing="12" Visibility="Collapsed">
            <TextBlock x:Name="DownloadStatusText" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="PercentageText" FontSize="14" />
            <ProgressBar x:Name="DownloadProgress" Height="8" Minimum="0" Maximum="100" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,22,0,0">
            <Button x:Name="CloseButton" MinWidth="90" Click="CloseButton_Click" />
            <Button x:Name="UpdateButton" MinWidth="90" Style="{StaticResource PrimaryButtonStyle}" Click="UpdateButton_Click" />
            <Button x:Name="CancelDownloadButton" MinWidth="90" Visibility="Collapsed" Click="CancelDownloadButton_Click" />
        </StackPanel>
    </Grid>
</Window>
