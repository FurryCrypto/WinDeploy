<Application
    x:Class="ESDInstaller.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <Color x:Key="ExplorerBlue">#FF0078D7</Color>
            <Color x:Key="ExplorerDarkBlue">#FF005A9E</Color>
            <Color x:Key="ExplorerPane">#FFF3F3F3</Color>
            <Color x:Key="ExplorerBorder">#FFD1D1D1</Color>
            <SolidColorBrush x:Key="ExplorerBlueBrush" Color="{StaticResource ExplorerBlue}" />
            <SolidColorBrush x:Key="ExplorerDarkBlueBrush" Color="{StaticResource ExplorerDarkBlue}" />
            <SolidColorBrush x:Key="ExplorerPaneBrush" Color="{StaticResource ExplorerPane}" />
            <SolidColorBrush x:Key="ExplorerBorderBrush" Color="{StaticResource ExplorerBorder}" />

            <Style TargetType="Button">
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="14,6" />
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="CornerRadius" Value="0" />
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="MinHeight" Value="30" />
            </Style>
            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource ExplorerBlueBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderBrush" Value="{StaticResource ExplorerDarkBlueBrush}" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="MinHeight" Value="36" />
                <Setter Property="Padding" Value="20,8" />
            </Style>
            <Style x:Key="ToolbarButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="MinHeight" Value="44" />
            </Style>
            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="26" />
                <Setter Property="FontWeight" Value="SemiLight" />
                <Setter Property="Foreground" Value="#FF1F1F1F" />
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="ExplorerCardStyle" TargetType="Border">
                <Setter Property="Background" Value="White" />
                <Setter Property="BorderBrush" Value="{StaticResource ExplorerBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Padding" Value="16" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
