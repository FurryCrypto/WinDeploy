<Page
    x:Class="ESDInstaller.Views.EditionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="32,26,32,22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Spacing="7" Margin="0,0,0,16">
            <TextBlock x:Uid="EditionPageTitle" Style="{StaticResource PageTitleStyle}" />
            <TextBlock x:Uid="EditionPageSubtitle" Foreground="#FF555555" TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource ExplorerCardStyle}" Padding="0">
            <ListView x:Name="EditionList" SelectionMode="Single" SelectionChanged="EditionList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="14,10" ColumnSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="125"/></Grid.ColumnDefinitions>
                            <Grid Width="32" Height="32" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <!-- Windows 10's perspective window mark. Vector geometry stays sharp at any DPI. -->
                                <Viewbox Width="30" Height="30" Visibility="{Binding Windows10LogoVisibility}">
                                    <Canvas Width="32" Height="32">
                                        <Path Fill="{StaticResource ExplorerBlueBrush}"
                                              Data="M2,7 L14,5.3 L14,15.2 L2,15.2 Z M2,16.8 L14,16.8 L14,26.7 L2,25 Z M15.6,5.1 L30,3 L30,15.2 L15.6,15.2 Z M15.6,16.8 L30,16.8 L30,29 L15.6,26.9 Z"/>
                                    </Canvas>
                                </Viewbox>

                                <!-- Windows 11's flat, evenly divided four-pane mark. -->
                                <Viewbox Width="28" Height="28" Visibility="{Binding Windows11LogoVisibility}">
                                    <Canvas Width="32" Height="32">
                                        <Path Fill="{StaticResource ExplorerBlueBrush}"
                                              Data="M2,2 L15,2 L15,15 L2,15 Z M17,2 L30,2 L30,15 L17,15 Z M2,17 L15,17 L15,30 L2,30 Z M17,17 L30,17 L30,30 L17,30 Z"/>
                                    </Canvas>
                                </Viewbox>

                                <!-- Older/unknown media use a neutral four-pane mark. -->
                                <Viewbox Width="27" Height="27" Visibility="{Binding OtherWindowsLogoVisibility}">
                                    <Canvas Width="32" Height="32">
                                        <Path Fill="{StaticResource ExplorerBlueBrush}"
                                              Data="M2,7 L14,5.3 L14,15.2 L2,15.2 Z M2,16.8 L14,16.8 L14,26.7 L2,25 Z M15.6,5.1 L30,3 L30,15.2 L15.6,15.2 Z M15.6,16.8 L30,16.8 L30,29 L15.6,26.9 Z"/>
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Description}" Foreground="#FF666666" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="3" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding Architecture}" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding Details}" FontSize="12" Foreground="#FF666666" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding Size}" FontSize="12" Foreground="#FF666666" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Button x:Uid="BackButton" Click="BackButton_Click" />
            <Button x:Name="NextButton" x:Uid="NextButton" HorizontalAlignment="Right" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False" Click="NextButton_Click" />
        </Grid>
    </Grid>
</Page>
