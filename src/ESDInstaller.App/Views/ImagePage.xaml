<Page
    x:Class="ESDInstaller.Views.ImagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AllowDrop="True"
    DragOver="Page_DragOver"
    Drop="Page_Drop">
    <Grid Padding="32,26,32,22">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0">
            <StackPanel Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock x:Uid="ImagePageTitle" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Uid="ImagePageSubtitle" TextWrapping="Wrap" Foreground="#FF555555" />

                <Border Style="{StaticResource ExplorerCardStyle}" Padding="24" MinHeight="170">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8E5;" FontSize="44" Foreground="{StaticResource ExplorerBlueBrush}" />
                        <Button x:Name="SelectImageButton" x:Uid="SelectImageButton" Style="{StaticResource PrimaryButtonStyle}" Click="SelectImageButton_Click" />
                        <TextBlock x:Uid="ImageDropHint" FontSize="12" Foreground="#FF666666" HorizontalAlignment="Center" />
                        <ProgressRing x:Name="InspectProgress" Width="26" Height="26" IsActive="False" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" IsClosable="True" />
                <InfoBar x:Name="LegacyBar" Severity="Warning" IsOpen="False" IsClosable="False" />

                <Border x:Name="ImageDetails" Style="{StaticResource ExplorerCardStyle}" Visibility="Collapsed">
                    <Grid ColumnSpacing="18" RowSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="155"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Uid="ImageFilenameLabel" FontWeight="SemiBold"/><TextBlock x:Name="FilenameText" Grid.Column="1" TextWrapping="Wrap"/>
                        <TextBlock x:Uid="ImageWindowsVersionLabel" Grid.Row="1" FontWeight="SemiBold"/><TextBlock x:Name="VersionText" Grid.Row="1" Grid.Column="1"/>
                        <TextBlock x:Uid="ImageArchitectureLabel" Grid.Row="2" FontWeight="SemiBold"/><TextBlock x:Name="ArchitectureText" Grid.Row="2" Grid.Column="1"/>
                        <TextBlock x:Uid="ImageTypeLabel" Grid.Row="3" FontWeight="SemiBold"/><TextBlock x:Name="TypeText" Grid.Row="3" Grid.Column="1"/>
                        <TextBlock x:Uid="ImageFileSizeLabel" Grid.Row="4" FontWeight="SemiBold"/><TextBlock x:Name="FileSizeText" Grid.Row="4" Grid.Column="1"/>
                        <TextBlock x:Uid="ImageEditionCountLabel" Grid.Row="5" FontWeight="SemiBold"/><TextBlock x:Name="EditionCountText" Grid.Row="5" Grid.Column="1"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="NextButton" x:Uid="NextButton" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False" Click="NextButton_Click" />
        </StackPanel>
    </Grid>
</Page>
