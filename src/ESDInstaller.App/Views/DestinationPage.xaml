<Page
    x:Class="ESDInstaller.Views.DestinationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="32,26,32,22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Spacing="7" Margin="0,0,0,12">
            <TextBlock x:Uid="DestinationPageTitle" Style="{StaticResource PageTitleStyle}" />
            <TextBlock x:Uid="DestinationPageSubtitle" Foreground="#FF555555" TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Row="1" Background="#FFE9F3FB" BorderBrush="#FFB6D6F2" BorderThickness="1" Padding="12" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Spacing="22">
                <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7E8;" Foreground="{StaticResource ExplorerBlueBrush}"/><TextBlock x:Name="FirmwareText" VerticalAlignment="Center"/></StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xEDA2;" Foreground="{StaticResource ExplorerBlueBrush}"/><TextBlock x:Name="ArchitectureText" VerticalAlignment="Center"/></StackPanel>
            </StackPanel>
        </Border>
        <Grid Grid.Row="2">
            <ScrollViewer><StackPanel x:Name="DiskPanel" Spacing="14" /></ScrollViewer>
            <ProgressRing x:Name="LoadingRing" Width="38" Height="38" HorizontalAlignment="Center" VerticalAlignment="Center" IsActive="False" Visibility="Collapsed" />
            <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" VerticalAlignment="Top" IsClosable="True" />
        </Grid>
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Button x:Uid="BackButton" Click="BackButton_Click" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="SelectionText" Foreground="#FF444444" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="440"/>
            </StackPanel>
            <Button x:Name="NextButton" x:Uid="NextButton" HorizontalAlignment="Right" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="False" Click="NextButton_Click" />
        </Grid>
    </Grid>
</Page>
