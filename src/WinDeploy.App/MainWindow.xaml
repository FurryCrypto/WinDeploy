<Window
    x:Class="WinDeploy.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="RootGrid" Background="#FFF7F7F7" RequestedTheme="Light">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource ExplorerBorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2">
                    <Button x:Name="OpenImageButton" Style="{StaticResource ToolbarButtonStyle}" Click="OpenImageButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8E5;" FontSize="18" Foreground="{StaticResource ExplorerBlueBrush}" />
                            <TextBlock x:Uid="ToolbarOpenImage" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RefreshDisksButton" Style="{StaticResource ToolbarButtonStyle}" Click="RefreshDisksButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72C;" FontSize="18" Foreground="{StaticResource ExplorerBlueBrush}" />
                            <TextBlock x:Uid="ToolbarRefreshDisks" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                    <Button x:Name="SettingsButton" Style="{StaticResource ToolbarButtonStyle}" Click="SettingsButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE713;" FontSize="18" />
                            <TextBlock x:Uid="ToolbarSettings" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="HelpButton" Style="{StaticResource ToolbarButtonStyle}" Click="HelpButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE897;" FontSize="18" />
                            <TextBlock x:Uid="ToolbarHelp" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="215" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource ExplorerPaneBrush}" BorderBrush="{StaticResource ExplorerBorderBrush}" BorderThickness="0,0,1,0">
                <StackPanel Padding="0,18,0,0">
                    <TextBlock x:Uid="StepsHeader" FontSize="12" FontWeight="SemiBold" Foreground="#FF555555" Margin="18,0,0,8" />
                    <Border x:Name="Step0" BorderThickness="3,0,0,0" Padding="15,10,8,10">
                        <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8E5;" FontSize="18"/><TextBlock x:Uid="StepImage" VerticalAlignment="Center" /></StackPanel>
                    </Border>
                    <Border x:Name="Step1" BorderThickness="3,0,0,0" Padding="15,10,8,10">
                        <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8A5;" FontSize="18"/><TextBlock x:Uid="StepEdition" VerticalAlignment="Center" /></StackPanel>
                    </Border>
                    <Border x:Name="Step2" BorderThickness="3,0,0,0" Padding="15,10,8,10">
                        <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xEDA2;" FontSize="18"/><TextBlock x:Uid="StepDestination" VerticalAlignment="Center" /></StackPanel>
                    </Border>
                    <Border x:Name="Step3" BorderThickness="3,0,0,0" Padding="15,10,8,10">
                        <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE7E8;" FontSize="18"/><TextBlock x:Uid="StepBoot" VerticalAlignment="Center" /></StackPanel>
                    </Border>
                    <Border x:Name="Step4" BorderThickness="3,0,0,0" Padding="15,10,8,10">
                        <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE9D5;" FontSize="18"/><TextBlock x:Uid="StepReview" VerticalAlignment="Center" /></StackPanel>
                    </Border>
                    <Border x:Name="Step5" BorderThickness="3,0,0,0" Padding="15,10,8,10">
                        <StackPanel Orientation="Horizontal" Spacing="10"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE9D2;" FontSize="18"/><TextBlock x:Uid="StepInstall" VerticalAlignment="Center" /></StackPanel>
                    </Border>
                    <Border Margin="15,24,15,0" Padding="10" Background="#FFE9F3FB" BorderBrush="#FFB6D6F2" BorderThickness="1">
                        <StackPanel Spacing="5">
                            <StackPanel Orientation="Horizontal" Spacing="7"><FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE946;" FontSize="16" Foreground="{StaticResource ExplorerBlueBrush}"/><TextBlock x:Uid="SafetyFirst" FontWeight="SemiBold" /></StackPanel>
                            <TextBlock x:Uid="SafetySidebarText" TextWrapping="Wrap" FontSize="12" Foreground="#FF444444" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
            <Frame x:Name="ContentFrame" Grid.Column="1" Background="#FFF7F7F7" />
        </Grid>

        <Border Grid.Row="2" Background="#FFF2F2F2" BorderBrush="{StaticResource ExplorerBorderBrush}" BorderThickness="0,1,0,0">
            <Grid Padding="10,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE946;" FontSize="13" />
                    <TextBlock x:Name="StatusText" x:Uid="StatusReadyLabel" FontSize="12" />
                </StackPanel>
                <TextBlock x:Name="ModeText" Grid.Column="1" VerticalAlignment="Center" FontSize="12" Foreground="#FF555555" />
            </Grid>
        </Border>
    </Grid>
</Window>
